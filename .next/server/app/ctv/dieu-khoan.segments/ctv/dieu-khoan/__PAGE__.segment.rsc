12:["$","div",null,{"className":"space-y-1.5 text-[14px] leading-relaxed text-muc-2","children":[["$","p",null,{"children":"Hoa hồng được tính theo mức phòng khám công bố tại thời điểm đăng ký, trên số tiền khách thực trả của hoá đơn mà người được giới thiệu sử dụng dịch vụ (lịch hẹn đặt qua link / mã QR, hoặc khách báo mã giới thiệu với lễ tân)."}],["$","p",null,{"children":"Hoá đơn bị huỷ, hoàn tiền hoặc điều chỉnh thì hoa hồng được điều chỉnh tương ứng."}]]}]
